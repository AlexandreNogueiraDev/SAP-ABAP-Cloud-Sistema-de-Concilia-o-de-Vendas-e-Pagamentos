managed implementation in class zbp_i_ale_venda unique;
strict ( 2 );

define behavior for ZI_ALE_VENDA alias Venda
persistent table ztale_venda
lock master
authorization master ( global )
{
  create;
  update;
  delete;

  field ( readonly, numbering : managed ) id_conciliacao;

  determination calcularStatus on modify
  {
    field valor_venda, valor_pago;
  }

  validation validarValores on save {
    field valor_venda, valor_pago;
  }
}